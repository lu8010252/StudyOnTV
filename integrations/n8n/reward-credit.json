    {
      "parameters": {
        "jsCode": "const state = $input.first().json;\nconst store = $getWorkflowStaticData('global');\nconst tz = 'Asia/Shanghai';\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: tz });\nconst yesterday = new Date(Date.now() - 86400000).toLocaleDateString('en-CA', { timeZone: tz });\n\nconst rounds = Number(state.roundsDoneToday || 0);\nconst target = Number((state.config && state.config.roundsPerDay) || 0);\nconst qualified = target > 0 && rounds >= target;\n\n// 同一天只累计一次，手动重跑不会把连续天数刷高\nif (store.lastDate !== today) {\n  if (qualified) {\n    store.streak = store.lastQualifiedDate === yesterday ? Number(store.streak || 0) + 1 : 1;\n    store.lastQualifiedDate = today;\n  } else {\n    store.streak = 0;\n    store.lastQualifiedDate = '';\n  }\n  store.lastDate = today;\n}\n\nconst streak = Number(store.streak || 0);\nconst reward = streak > 0 && streak % 5 === 0 && store.rewardedDate !== today ? 1 : 0;\nreturn [{ json: { streak, rounds, target, qualified, reward } }];"
      },
      "id": "3b8e3c2c-2030-4e03-9003-000000000303",
