#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    config_load studyontv-watchdog
    local enabled serial package interval repair adb
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || return 0
    config_get serial main serial
    config_get package main package com.studyontv.tv
    config_get interval main interval 30
    config_get_bool repair main repair_accessibility 0
    config_get adb main adb /usr/bin/adb
    procd_open_instance
    procd_set_param command /bin/sh /usr/libexec/studyontv-watchdog.sh watch
    procd_set_param env "SOTV_SERIAL=$serial" "SOTV_PACKAGE=$package" "SOTV_INTERVAL=$interval" "SOTV_REPAIR_ACCESSIBILITY=$repair" "SOTV_ADB=$adb"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() { procd_add_reload_trigger studyontv-watchdog; }
