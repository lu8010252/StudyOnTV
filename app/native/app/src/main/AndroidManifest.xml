<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 同步自愈：adb 一次性授权（pm grant com.studyontv.tv android.permission.WRITE_SECURE_SETTINGS），
         授权后 App 被固件摘掉无障碍时能自己写回去；未授权时 heal() 静默跳过 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 复活账户：addAccountExplicitly 在旧版本需要这条（安装时权限，无需用户确认） -->
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
    <!-- 同步框架自愈：缺 READ/WRITE_SYNC_SETTINGS 时 setSyncAutomatically/addPeriodicSync 会抛
         SecurityException，同步适配器永远不启用（安装时权限，必须声明） -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 语音输入：家长填了 DeepSeek Key 时自己录音上传识别（不填仍然走系统识别器） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <!-- 不计时白名单：家长面板要列出已安装的可启动应用 -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <!-- 本地语音诊断：Android 11+ 不声明就查不到任何 TTS 引擎（#128） -->
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/ic_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified" />

        <!-- 桌面入口单独做成 alias：家长可以在面板里关掉它来隐藏图标（防止孩子误点 / 卸载），
             关掉只影响这一条入口，MainActivity、前台服务和无障碍都不受影响。 -->
        <activity-alias
            android:name=".Launcher"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:banner="@drawable/ic_banner"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 可选的电视桌面：alias 默认禁用，家长在面板里打开后 DesktopMode 才启用它。
             关掉只是把 alias 禁回去，不会卸载、也不会重启进程；HomeActivity 起不来自动退回系统桌面。 -->
        <activity
            android:name=".HomeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <activity-alias
            android:name=".HomeAlias"
            android:banner="@drawable/ic_banner"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- singleInstance 的任务里只能放一个 Activity：填空题输入页（TvTextInputActivity）
             因此只能另起一个任务，输入页 finish 后任务归零，前台掉回桌面，小米固件随即强停本应用（#160）。
             singleTask 仍然独占 com.studyontv.tv.gate 这个任务，但允许输入页叠在学习页之上。 -->
        <activity
            android:name=".GateActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:taskAffinity="com.studyontv.tv.gate"
            android:theme="@style/GateTheme" />

        <activity android:name=".EducationalVideoActivity" android:exported="false" android:configChanges="orientation|screenSize" />

        <activity
            android:name=".UpdateActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="unspecified"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <activity
            android:name=".OnboardingActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:screenOrientation="unspecified" />

        <activity android:name=".ParentActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".GateService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="kids_screen_time_gate" />
        </service>

        <service
            android:name=".WatchAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 通知监听复活：系统在进程被强停后会重新绑定它，借此拉起 GateService。
             只使用绑定生命周期，不读取任何通知内容。 -->
        <service
            android:name=".RevivalListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 同步框架自愈（GuardSync.kt）：settings authority 上的本地同步。
             固件强停时「把自己从无障碍列表里摘掉」本身是 settings 写入，会触发 LOCAL 同步，
             系统随之显式 bind 拉起进程；周期同步则在 stopped 状态下兜底并清除 stopped 标记。 -->
        <service
            android:name=".GuardAccountService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/guard_account" />
        </service>

        <service
            android:name=".GuardSyncService"
            android:exported="true"
            android:permission="android.permission.BIND_SYNC_ADAPTER">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/guard_sync" />
        </service>

        <!-- 系统 PackageInstaller 的安装结果回到这里，失败原因写进诊断日志和家长面板 -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />

        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".UninstallGuard"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".Watchdog"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- 屏幕点亮 / 用户解锁 / 网络变化时检查服务是否存活，用于进程被杀后的快速拉起 -->
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <!-- TCL / 海信等厂商开机广播 -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="com.tcl.android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.hisense.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 自唤醒：AlarmManager 每分钟检查一次，服务被系统杀掉（电视内存太小）就重新拉起 -->
        <!-- exported：机顶盒上的外部看门要用 adb 直接给它发广播（GateService 不对外开放，shell 启动不了）；
             它只会确保服务在运行，没有别的副作用 -->
        <receiver
            android:name=".ReviveReceiver"
            android:exported="true" />
    </application>
</manifest>
